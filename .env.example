# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zappie

# Development identity used only when no session exists outside production.
ZAPPIE_DEV_EMAIL=demo@zappie.local

# 32-byte AES-256 key encoded as 64 hexadecimal characters.
# Generate one with: openssl rand -hex 32
ZAPPIE_ENCRYPTION_KEY=

# Optional production email support
RESEND_API_KEY=
RESEND_FROM_EMAIL=Zappie <noreply@example.com>

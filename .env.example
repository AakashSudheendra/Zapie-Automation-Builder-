# PostgreSQL (Supabase or another hosted PostgreSQL provider)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Development identity used only when no session exists outside production.
ZAPPIE_DEV_EMAIL=demo@zappie.local

# Generate each secret independently with: openssl rand -hex 32
ZAPPIE_WEBHOOK_SECRET=
CRON_SECRET=

# 32-byte AES-256 key encoded as 64 hexadecimal characters.
ZAPPIE_ENCRYPTION_KEY=

# Optional production email support
RESEND_API_KEY=
RESEND_FROM_EMAIL=Zappie <noreply@your-verified-domain.com>
